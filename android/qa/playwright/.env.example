# Required app identity. APP_ACTIVITY may be omitted if the package has one
# launchable activity.
APP_PACKAGE=com.runform
APP_ACTIVITY=

# Optional device selection; required when more than one Android device is online.
ANDROID_SERIAL=

# Stable resource-id-compatible Compose test tags.
TAG_LOGIN_EMAIL=login_email
TAG_LOGIN_PASSWORD=login_password
TAG_LOGIN_SUBMIT=login_submit
TAG_LOGIN_ERROR=login_error
TAG_HOME_SCREEN=home_screen
TAG_LOGOUT=profile_logout
TAG_REGISTER_LINK=register_link
TAG_FORGOT_PASSWORD_LINK=forgot_password_link

# Required only for credential-dependent acceptance tests.
QA_EMAIL=
QA_PASSWORD=
QA_BAD_PASSWORD=definitely-not-the-password

# Set to 1 only against a resettable, non-production QA backend.
RUN_MUTATING_AUTH_TESTS=0
